# --- Discord app ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set for instant slash-command registration during development.
# Leave empty to register commands globally (takes up to ~1h to propagate).
DISCORD_GUILD_ID=

# --- Web server ---
PORT=3000
# Public URL this app is served behind, e.g. https://bitcoinsilver.eu/faucet
PUBLIC_BASE_URL=https://bitcoinsilver.eu/faucet

# --- Internal bot -> server API auth ---
# Shared secret used to HMAC-sign the request the Discord bot sends to the
# faucet API. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# --- BTCS node RPC (bitcoind-compatible) ---
# Leave these empty to run in MOCK mode: the faucet will validate addresses
# structurally, log what it would have sent, and return a fake txid instead
# of moving real funds. Fill them in once a BTCS node is available.
BTCS_RPC_HOST=127.0.0.1
BTCS_RPC_PORT=8332
BTCS_RPC_USER=
BTCS_RPC_PASS=
# Optional: set if the node uses named wallets (Bitcoin Core >= 0.17 style),
# e.g. "faucet" -> requests go to /wallet/faucet
BTCS_RPC_WALLET=
# Optional: only needed if the faucet wallet is encrypted
BTCS_RPC_WALLET_PASSPHRASE=

# --- Faucet rules ---
FAUCET_MIN_AMOUNT=0.6
FAUCET_MAX_AMOUNT=1.8
FAUCET_COOLDOWN_HOURS=24
# Shown in /help, the /faucet-setup pinned message, and the public /faucet
# page, so people can top up the faucet wallet. Optional - leave blank to
# hide it everywhere.
FAUCET_TOPUP_ADDRESS=

# --- Web claiming (optional) ---
# Lets anyone claim directly from the /faucet page, not just via Discord.
# Leave both blank to keep the web form disabled (shows a "not available yet"
# message) - it stays off until both are set, so deploying this feature can't
# accidentally leave the site claimable with no anti-bot check in place.
# Get these free at https://dash.cloudflare.com/?to=/:account/turnstile
# (create a "Managed" widget for your domain). TURNSTILE_SITE_KEY is public
# (safe to expose client-side); TURNSTILE_SECRET_KEY must stay server-side only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Storage ---
DATABASE_PATH=./data/faucet.json

# --- Daily technical-analysis post (optional) ---
# Posts a BTCS/USDC chart update (price action, key levels, AI commentary) to
# a Discord channel once a day, plus lets admins trigger it on demand with
# /post-ta. Leave both blank to keep it disabled entirely.
# Get an API key at https://console.anthropic.com (separate from any
# Claude.ai/Claude Code subscription - pay-as-you-go, a few cents/month at
# this volume using Haiku).
ANTHROPIC_API_KEY=
# Right-click the target channel in Discord (Developer Mode on) -> Copy Channel ID.
TA_CHANNEL_ID=
# NonKYC market symbol to track.
TA_MARKET=BTCS_USDC
# Candle size in minutes for the chart-structure analysis.
TA_RESOLUTION_MINUTES=15
# How far back to look when detecting support/resistance swing levels.
TA_LOOKBACK_HOURS=48
# Cron schedule (UTC) for the automatic daily post. Default: 09:00 UTC.
TA_CRON=0 9 * * *
